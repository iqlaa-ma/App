# Docker Environment Configuration
# Copy this file to .env and update the SECRET_KEY

# Database Configuration
DATABASE_URL=sqlite:///./data/app.db
# For PostgreSQL (uncomment and modify):
# DATABASE_URL=postgresql://authuser:authpass@postgres:5432/authdb

# JWT Configuration
# IMPORTANT: Generate a secure key using: make generate-key
SECRET_KEY=change-this-to-a-secure-random-key-run-make-generate-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Configuration
APP_NAME=Mobile Auth API
DEBUG=True

# Docker specific settings
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1